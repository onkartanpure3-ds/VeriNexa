# VeriNexa Backend Configuration Example
# Copy this file to .env and replace placeholders with your credentials

# News API Configuration (Get free key from https://newsapi.org/)
NEWSAPI_KEY=your_newsapi_key_here
NEWSAPI_URL=https://newsapi.org/v2/everything
GDELT_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_ENABLED=true
GOOGLE_NEWS_ENABLED=true

# Server Configuration
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Canonical Neural Models (Preserves MPNet & DeBERTa-v3)
MPNET_MODEL=sentence-transformers/all-mpnet-base-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Concurrency & Memory Controls (Enforces CPU bounds)
TORCH_THREADS=1
MAX_CONCURRENT_VERIFICATIONS=1
RANKER_BATCH_SIZE=8
NLI_BATCH_SIZE=4
MAX_CANDIDATES=15
TOP_K_EVIDENCE=8
EVIDENCE_WINDOW_DAYS=30
LOG_LEVEL=INFO
