# VeriNexa Backend Configuration Example
# Copy this file to .env and replace placeholders with your credentials

# News API Configuration (Get free key from https://newsapi.org/)
NEWSAPI_KEY=your_newsapi_key_here
GDELT_ENABLED=true
GOOGLE_NEWS_ENABLED=true

# Server Configuration
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Retrieval & Scoring Settings
TOP_K_EVIDENCE=10
MAX_CANDIDATES=25
LOG_LEVEL=INFO
